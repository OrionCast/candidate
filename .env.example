# Copiez ce fichier vers .env.local puis remplissez les valeurs.
# Ne mettez jamais de vraies clés dans .env.example (il est versionné).

# --- Supabase (Project Settings -> API Keys) ---
# URL du projet
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (anon / publishable) : visible dans le navigateur, limitée par la RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète (service_role) : SERVEUR UNIQUEMENT.
# Ne jamais la préfixer par NEXT_PUBLIC_ ni la partager.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact ---
# Adresse qui reçoit les messages du formulaire de contact (ouvre la messagerie du visiteur).
# Facultatif : par défaut formationpatn@cciamb-cnia.cg
NEXT_PUBLIC_CONTACT_EMAIL=
